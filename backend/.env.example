# Database
DATABASE_URL="postgresql://usuario:senha@localhost:5432/porta_a_porta?schema=public"

# Server
PORT=3000
NODE_ENV=development

# JWT - gere um valor longo e aleatório, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque_por_um_valor_aleatorio"
JWT_EXPIRES_IN="7d"

# CORS
FRONTEND_URL="http://localhost:8081"

# Pasta onde as fotos dos produtos são guardadas (padrão: backend/uploads)
UPLOAD_DIR="./uploads"
